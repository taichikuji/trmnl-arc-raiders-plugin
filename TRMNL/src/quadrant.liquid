<div class="arc text--bold arc-compact arc-quarter">
  {% render "arc_compact_header", info: info, vertical: false %}
  <div class="arc-compact-items">
    <div class="arc-overline font--small">ACTIVE &nbsp; / &nbsp; {{ info.live_count }} TOTAL</div>
    {% for entry in info.live limit:1 %}
      {% render "arc_compact_entry", entry: entry, index: 0, show_state: false %}
    {% endfor %}
    <div class="arc-overline font--small">COMING UP</div>
    {% for entry in info.next limit:2 %}
      {% render "arc_compact_entry", entry: entry, index: 0, show_state: false %}
    {% endfor %}
    {% if info.has_feature == false %}<div class="arc-empty font--small">NO SCHEDULE</div>{% endif %}
  </div>
  <div class="arc-c-footer font--small">UNOFFICIAL &nbsp; / &nbsp; METAFORGE.APP</div>
</div>
