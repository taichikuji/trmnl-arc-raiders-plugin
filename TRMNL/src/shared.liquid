{% comment %}ARC Raiders field schedule: text and vector shapes are self-contained, with no remote image requests.{% endcomment %}
{% assign info = briefing %}
{% template arc_compact_header %}
  <div class="arc-c-head flex flex--row flex--between"><div class="arc-c-brand flex flex--row flex--left w--min-0"><div class="arc-brand-bars"><span></span><span></span><span></span></div><div class="arc-c-logo font--base lg:font--large">ARC RAIDERS</div></div><div class="arc-c-meta font--small">{% if vertical %}MAP CONDITIONS &nbsp; / &nbsp; {% endif %}{{ info.region | escape }} &nbsp; / &nbsp; AS OF {{ info.clock }}</div></div>
{% endtemplate %}
{% template arc_entry %}
  <div class="arc-entry flex flex--row flex--left"><div class="arc-entry-icon flex flex--row"><svg class="arc-icon" aria-hidden="true"><use href="#{{ entry.icon_id }}"></use></svg></div><div class="arc-entry-info w--min-0"><div class="arc-entry-name font--small lg:font--base">{{ entry.name | escape }}</div><div class="arc-entry-map font--small">{{ entry.map | escape }}</div></div><div class="arc-entry-right text--right"><div class="arc-entry-time font--small lg:font--base">{% if entry.state == 'NEXT' %}IN {% endif %}{{ entry.until_label }}{% if entry.state == 'LIVE' %} LEFT{% endif %}</div><div class="arc-entry-when font--small">{{ entry.when }}</div></div></div>
{% endtemplate %}
{% template arc_compact_entry %}
  <div class="arc-c-row flex flex--row flex--left{% if index > 4 %} arc-extra{% endif %}"><svg class="arc-icon" aria-hidden="true"><use href="#{{ entry.icon_id }}"></use></svg><div class="arc-c-body w--min-0"><div class="arc-c-title font--base">{{ entry.name | escape }}</div><div class="arc-c-sub font--small">{{ entry.map | escape }}{% if show_state %} &nbsp; / &nbsp; {{ entry.state }}{% endif %} &nbsp; / &nbsp; {{ entry.time }}</div></div><div class="arc-c-right text--right font--small lg:font--base">{% if entry.state == 'NEXT' %}IN {% endif %}{{ entry.until_label }}{% if entry.state == 'LIVE' %} LEFT{% endif %}</div></div>
{% endtemplate %}
<style>
.arc { width:100%;height:100%;overflow:hidden;color:#111216;background:#fff;display:flex;flex-direction:column; }
.arc-icon-sprite {width:0;height:0;overflow:hidden;pointer-events:none }
.arc-icon { width:25px;height:25px;flex:none;display:block;color:inherit;overflow:visible }
.arc-brand-bars { display:flex;gap:3px;height:18px;align-items:center;margin-right:11px;transform:skew(22deg) }
.arc-brand-bars span { background:#141518;width:5px;height:18px }
.arc-header {flex:none;min-height:53px;padding:11px 20px 10px;border-bottom:3px solid #111216;gap:10px }
.arc-brand { white-space:nowrap }
.arc-meta { letter-spacing:1px;text-align:right;white-space:nowrap }
.arc-meta span { display:block;color:#555;letter-spacing:1.2px;margin-top:3px }
.arc-main { flex:1;min-height:0;padding:13px 19px 10px;gap:18px }
.arc-hero {min-width:0;background:#111216;color:#fff;padding:19px;display:flex;flex-direction:column;overflow:hidden }
.arc-hero:before,.arc-hero:after { content:"";position:absolute;width:23px;height:23px;pointer-events:none;color:#949596 }
.arc-hero:before { right:12px;top:12px;border-top:1px solid;border-right:1px solid }
.arc-hero:after { left:12px;bottom:12px;border-left:1px solid;border-bottom:1px solid }
.arc-kicker { letter-spacing:1.7px;white-space:nowrap }
.arc-live-dot { display:inline-block;width:7px;height:7px;border:1px solid currentColor;border-radius:100%;background:currentColor;margin-right:7px }
.arc-hero-middle { flex:1;min-height:0;display:flex;flex-direction:column;justify-content:flex-end;padding-top:87px }
.arc-hero-icon {right:9px;top:9px;width:82px;height:82px;border:1px solid #858585;padding:14px;color:#fff }
.arc-hero-name { overflow-wrap:break-word;max-width:100%;margin:0 0 11px }
.arc-hero-map { letter-spacing:1px;border-top:1px solid #777;padding:10px 0 13px }
.arc .arc-hero-bottom {gap:5px;border-top:1px solid #777;padding-top:12px }
.arc-hero-hint { letter-spacing:.9px;text-align:right; }
.arc-section { flex:1;min-width:0;min-height:0;display:flex;flex-direction:column;overflow:hidden }
.arc .arc-section-head { letter-spacing:1.7px;padding:1px 0 6px;border-bottom:2px solid #111216;align-items:baseline;flex:none }
.arc-section-head span:last-child { letter-spacing:.7px;color:#424242 }
.arc-next-head { margin-top:10px }
.arc-entries { display:flex;flex-direction:column;flex:none;min-height:0 }
.arc .arc-entry {gap:9px;padding:3px 0;border-bottom:1px solid #c9c9c4;min-height:32px;flex:none }
.arc-entry-icon { width:25px;height:25px;flex:none }
.arc-entry-info { flex:1 }
.arc-entry-name,.arc-entry-map,.arc-c-title,.arc-c-sub { overflow:hidden;text-overflow:ellipsis;white-space:nowrap }
.arc-entry-map { color:#484848;letter-spacing:.8px;margin-top:2px }
.arc-entry-right {flex:none;white-space:nowrap;min-width:66px }
.arc-entry-when { color:#555;margin-top:3px }
.arc .arc-footer {gap:12px;flex:none;border-top:3px solid #111216;min-height:26px;padding:5px 19px 7px;letter-spacing:.65px;white-space:nowrap }
.arc-empty { padding:12px 0;color:#555 }
.arc-compact { padding:10px 14px 7px }
.arc .arc-c-head { flex:none;gap:7px;border-bottom:3px solid #111216;padding-bottom:8px }
.arc .arc-c-brand {gap:8px }
.arc-c-brand .arc-brand-bars { height:15px;margin:0;gap:2px }
.arc-c-brand .arc-brand-bars span { height:15px;width:4px }
.arc-c-logo { white-space:nowrap }
.arc-c-meta { letter-spacing:.5px;white-space:nowrap }
.arc-compact-items { flex:1;min-height:0;overflow:hidden;display:flex;flex-direction:column;justify-content:space-around }
.arc .arc-c-row {gap:9px;border-bottom:1px solid #c6c6c6;padding:6px 0;min-height:41px }
.arc-c-row .arc-icon { width:28px;height:28px }
.arc-c-body { flex:1 }
.arc-c-sub { color:#555;letter-spacing:.6px;margin-top:3px; }
.arc-c-right { flex:none;white-space:nowrap;min-width:56px }
.arc-c-footer { flex:none;letter-spacing:.65px;padding-top:5px;white-space:nowrap }
.arc-overline { letter-spacing:1.3px;padding:6px 0 4px }
.arc.arc-half-vertical .arc-c-head { flex-direction:column;align-items:flex-start }
.arc-half-vertical .arc-compact-items { justify-content:flex-start }
.arc-half-vertical .arc-c-row { min-height:49px }
.arc-quarter .arc-c-row { min-height:40px;padding:4px 0 }
.arc-quarter .arc-c-row .arc-icon { width:22px;height:22px }
.arc-quarter .arc-c-right { min-width:43px }
.arc-quarter .arc-overline { padding:3px 0 }
/* OG: reserve space for both sections. */
@media(max-height:600px) {
  .arc-live-list>.arc-entry:nth-child(n+5),.arc-next-list>.arc-entry:nth-child(n+5),.arc-half-vertical .arc-extra { display:none }
}
/* X: use the additional vertical resolution instead of leaving the right panel empty. */
@media(min-height:650px) {
  .arc-header { min-height:70px;padding:17px 26px 15px }
  .arc-brand-bars { height:24px;gap:4px;margin-right:15px }
  .arc-brand-bars span { height:24px;width:7px }
  .arc-main { gap:24px;padding:21px 25px 17px }
  .arc-hero { padding:27px }
  .arc-hero-icon { width:118px;height:118px;top:20px;right:20px;padding:20px }
  .arc-hero-middle { padding-top:146px }
  .arc-hero-map { padding-top:15px;padding-bottom:20px }
  .arc .arc-section-head { padding:2px 0 9px }
  .arc-next-head { margin-top:17px }
  .arc .arc-entry { min-height:40px;padding:3px 0;gap:11px }
  .arc-entry-icon,.arc-entry-icon .arc-icon { width:31px;height:31px }
  .arc-entry-right { min-width:78px }
  .arc .arc-footer { min-height:38px;padding:8px 25px }
}
.screen--lg .arc-compact .arc-c-row .arc-icon { width:30px;height:30px }
</style>
