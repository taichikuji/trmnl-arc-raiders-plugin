{% endcapture %}

{% template arc_icon %}
  {% assign icon_id = entry.name | downcase | replace: ' ', '-' | prepend: 'arc-icon-' %}
  {% capture marker %}id="{{ icon_id }}"{% endcapture %}
  {% unless sprites contains marker %}{% assign marker = 'id="arc-icon-default"' %}{% endunless %}
  {% assign drawing = sprites | split: marker | last | split: '</symbol>' | first %}
  <svg class="{{ size }}" aria-hidden="true"{{ drawing }}</svg>
{% endtemplate %}

{% template arc_header %}
  <header class="flex flex--row flex--between w--full pb--2 border--h-black gap--small">
    <img class="image image--adaptive no-shrink h--[18px] lg:h--6 {% if narrow %}w--[72px]{% else %}w--40 portrait:w--24 lg:w--52 lg:portrait:w--40{% endif %}" alt="ARC Raiders" src="data:image/svg+xml;base64,{{ wordmark }}">
    <span class="label label--base lg:label--large">{{ info.region | replace: '-', ' ' | upcase | escape }}</span>
  </header>
{% endtemplate %}

{% template arc_feature %}
  <section class="inverse flex flex--col flex--top gap--none w--full h--full p--4 lg:p--6" data-feature="true"{% if entry %} data-entry="true" data-active="{{ entry.active }}"{% endif %}>
    <div class="flex flex--row flex--between w--full">
      <span class="label label--base lg:label--large text--bold">{% if info.stale %}STALE SOURCE{% elsif entry.active %}ACTIVE{% elsif entry %}UPCOMING{% else %}STANDBY{% endif %}</span>
      <span class="label label--base lg:label--large portrait:hidden">TOPSIDE</span>
    </div>
    <div class="flex flex--col flex--center w--full grow gap--small">
      {% render "arc_icon", entry: entry, sprites: sprites, size: 'w--32 h--32 portrait:w--16 portrait:h--16 lg:w--48 lg:h--48 lg:portrait:w--40 lg:portrait:h--40' %}
      <div class="flex flex--col gap--none w--min-0 flex--center w--full">
        <span class="title title--large lg:title--xlarge lg:portrait:title--base text--center w--full" data-clamp="{% if entry %}2{% else %}3{% endif %}" data-condition-name="true">{% if entry %}{{ entry.name | upcase | escape }}{% else %}{{ info.status | upcase | escape }}{% endif %}</span>
        {% if entry %}<span class="title title--base lg:title--large portrait:title--small lg:portrait:title--base" data-clamp="1" data-clamp-lg-portrait="1">{{ entry.map | upcase | escape }}</span>{% endif %}
      </div>
    </div>
    {% if entry %}
      <div class="flex flex--row flex--between flex--bottom w--full pt--2 gap--small portrait:flex--col portrait:flex--left portrait:gap--none">
        {% comment %}Value fitting measures its parent, which must exclude the scheduled time.{% endcomment %}
        <div class="stretch-x w--min-0 portrait:w--full">
          <span class="value value--base lg:value--large" data-fit-value="true">{{ entry.until_label | remove: ' left' | remove: 'In ' | upcase }}</span>
        </div>
        <span class="title title--base lg:title--large text--right portrait:text--left no-shrink">{% if entry.active %}ENDS{% else %}STARTS{% endif %}<br class="portrait:hidden"> {{ entry.time | upcase | escape }}</span>
      </div>
    {% endif %}
  </section>
{% endtemplate %}

{% template arc_entry %}
  <div class="flex flex--row flex--left gap--small w--full border--h-50 {% if narrow %}h--[72px]{% elsif tight %}h--[42px] lg:h--[62px] portrait:h--[64px] lg:portrait:h--[62px]{% else %}h--[48px] lg:h--[68px] portrait:h--[64px] lg:portrait:h--[68px]{% endif %}" data-entry="true" data-active="{{ entry.active }}">
    {% unless narrow %}{% render "arc_icon", entry: entry, sprites: sprites, size: 'w--7 h--7 lg:w--10 lg:h--10' %}{% endunless %}
    <div class="flex flex--col flex--left gap--none stretch-x w--min-0">
      <div class="flex flex--row flex--between gap--small w--full">
        <span class="title {% if narrow %}title--small lg:title--base{% else %}title--base lg:title--large{% endif %} stretch-x w--min-0" data-clamp="{% if narrow %}2{% else %}1{% endif %}" data-clamp-portrait="2" data-clamp-lg-portrait="1" data-condition-name="true">{{ entry.name | escape }}</span>
        {% unless tight %}<span class="label label--base lg:label--large text--bold no-shrink">{{ entry.until_label | escape }}</span>{% endunless %}
      </div>
      <div class="flex {% if narrow %}flex--col flex--left gap--none{% elsif tight %}flex--row flex--between gap--small{% else %}flex--row flex--between gap--none{% endif %} w--full">
        <span class="label label--base lg:label--large" data-clamp="1">{{ entry.map | escape }}</span>
        <span class="label label--base lg:label--large{% if tight %} no-shrink{% endif %}">{% if tight %}{% if entry.active %}Ends{% else %}Starts{% endif %} {{ entry.time | escape }}{% else %}{{ entry.when | escape }}{% endif %}</span>
      </div>
    </div>
  </div>
{% endtemplate %}

{% template arc_omitted %}
  {% assign omitted_active = info.live.size | minus: shown_active %}
  {% assign omitted_next = info.next.size | minus: shown_next %}
  {% assign omitted = omitted_active | plus: omitted_next %}
  {% if omitted > 0 %}<span class="label label--base lg:label--large pt--1" data-omitted="{{ omitted }}">+{% if omitted_active > 0 %}{{ omitted_active }} active{% endif %}{% if omitted_active > 0 and omitted_next > 0 %} · {% endif %}{% if omitted_next > 0 %}{{ omitted_next }} upcoming{% endif %}</span>{% endif %}
{% endtemplate %}

{% template arc_compact %}
  {% if info.stale %}{% assign limit = limit | minus: 1 %}{% endif %}
  {% assign entries = info.live | concat: info.next | slice: 0, limit %}
  {% assign shown_active = info.live.size | at_most: entries.size %}
  {% assign shown_next = entries.size | minus: shown_active %}
  <div class="layout layout--col layout--top gap--none">
    {% render "arc_header", wordmark: wordmark, info: info, narrow: narrow_rows %}
    <main class="flex flex--col flex--top gap--none w--full">
      <div class="flex flex--col flex--left gap--none w--full py--1 border--h-black">
        {% if info.stale %}<span class="label label--base lg:label--large text--bold">STALE SOURCE</span>{% endif %}
        <span class="label label--base lg:label--large">{{ info.live.size }} ACTIVE · {{ info.next.size }} NEXT</span>
      </div>
      {% for entry in entries %}
        {% render "arc_entry", entry: entry, sprites: sprites, tight: true, narrow: narrow_rows %}
      {% else %}
        <span class="label label--base lg:label--large py--2">{{ info.status | escape }}</span>
      {% endfor %}
      {% render "arc_omitted", info: info, shown_active: shown_active, shown_next: shown_next %}
    </main>
  </div>
{% endtemplate %}

{% template arc_schedule_column %}
  <section class="flex flex--col flex--top gap--none w--full w--min-0" aria-label="{{ heading }} conditions">
    <div class="flex flex--row flex--between w--full py--1 border--h-black">
      <span class="label label--base lg:label--large text--bold">{{ heading | upcase }}</span>
      <span class="label label--base lg:label--large">{{ total }} TOTAL</span>
    </div>
    {% for entry in entries %}
      {% render "arc_entry", entry: entry, sprites: sprites, tight: true, narrow: narrow %}
    {% else %}
      <span class="label label--base lg:label--large py--2 w--full">No {{ heading | downcase }} conditions</span>
    {% endfor %}
  </section>
{% endtemplate %}
