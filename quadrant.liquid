<div class="arc arc-compact arc-quarter">
  <div class="arc-c-head"><div class="arc-c-brand"><div class="arc-brand-bars"><span></span><span></span><span></span></div><div class="arc-c-logo">ARC RAIDERS</div></div><div class="arc-c-meta">{{ info.region | escape }}</div></div>
  <div class="arc-compact-items">
    <div class="arc-overline">ACTIVE &nbsp; / &nbsp; {{ info.live_count }}</div>
    {% for entry in info.live limit:1 %}
      <div class="arc-c-row"><svg class="arc-icon" aria-hidden="true"><use href="#{{ entry.icon_id }}"></use></svg><div class="arc-c-body"><div class="arc-c-title">{{ entry.name | escape }}</div><div class="arc-c-sub">{{ entry.map | escape }}</div></div><div class="arc-c-right">{{ entry.until_label }}</div></div>
    {% endfor %}
    <div class="arc-overline">COMING UP</div>
    {% for entry in info.next limit:2 %}
      <div class="arc-c-row"><svg class="arc-icon" aria-hidden="true"><use href="#{{ entry.icon_id }}"></use></svg><div class="arc-c-body"><div class="arc-c-title">{{ entry.name | escape }}</div><div class="arc-c-sub">{{ entry.map | escape }}</div></div><div class="arc-c-right">{{ entry.time }}</div></div>
    {% endfor %}
    {% if info.has_feature == false %}<div class="arc-empty">NO SCHEDULE</div>{% endif %}
  </div>
  <div class="arc-c-footer">UNOFFICIAL &nbsp; / &nbsp; METAFORGE.APP</div>
</div>
